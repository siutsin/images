{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits"
  ],
  "automerge": true,
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": { "enabled": true },
  "rebaseWhen": "behind-base-branch",
  "logLevelRemap": [
    {
      "matchMessage": "/Some .+ did not have a releaseTimestamp, but as we're running with minimumReleaseAgeBehaviour=timestamp-optional, proceeding/",
      "newLogLevel": "info"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["docker", "dockerfile", "helm", "helm-values"],
      "minimumReleaseAge": "1 day",
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "matchPackageNames": ["dataaxiom/ghcr-cleanup-action"],
      "abandonmentThreshold": null
    },
    {
      "description": "Vulnerability fixes ship at once. The age wait stays for all other updates.",
      "matchJsonata": ["$exists(vulnerabilityFixVersion) or $exists(isVulnerabilityAlert)"],
      "minimumReleaseAge": null
    }
  ]
}
